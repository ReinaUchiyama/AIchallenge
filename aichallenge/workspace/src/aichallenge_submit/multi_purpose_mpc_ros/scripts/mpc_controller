#!/usr/bin/env python3

import sys
import threading

# ROS 2
import rclpy
from rclpy.signals import SignalHandlerOptions
from rclpy.executors import MultiThreadedExecutor

# Project
from multi_purpose_mpc_ros.mpc_controller import MPCController
from multi_purpose_mpc_ros.common import parse_args_without_ros


def main(argv = sys.argv) -> None:
    node = None
    executor_thread = None
    unexpected_failure = False

    args = parse_args_without_ros(argv)
    rclpy.init(args=argv, signal_handler_options=SignalHandlerOptions.NO)
    executor = MultiThreadedExecutor(num_threads=2)

    try:
        node = MPCController(args.config_path, args.ref_vel_path)
        executor.add_node(node)
        executor_thread = threading.Thread(target=executor.spin)
        executor_thread.start()
        node.run()
    except KeyboardInterrupt:
        if node is not None:
            node.get_logger().info("Shutdown requested")
    except Exception:
        unexpected_failure = True
        raise
    finally:
        if node is not None:
            # Do not call the failed control path again while unwinding an
            # unexpected exception. stop() still publishes an immediate zero.
            node.stop(run_control_loop=not unexpected_failure)
        executor.shutdown()
        if executor_thread is not None:
            executor_thread.join(timeout=1.0)
        if node is not None:
            node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main(sys.argv)
